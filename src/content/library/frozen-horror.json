      }
    },
    {
      "kind": "ability",
      "expansion": "Frozen Horror",
      "data": {
        "id": "fhTwoAttacks",
        "name": "Two attacks",
        "text": "Attacks twice each turn, once with its paw and once with its mace. Both can go at one hero, or one at each of two heroes. A hero defends only once per turn against it, however many of its attacks are aimed at them.",
        "kind": "ability"
      }
    },
