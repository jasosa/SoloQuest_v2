  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "type": "showText",
          "text": "The heroes line up outside the iron door in the north-west corner of the map. The way on is a wooden exit door at the other end of the fortress.",
          "title": "The Glacial Gate"
        }
      ]
    },
    {
      "id": "n-A",
      "letter": "A",
      "at": [2, 8],
      "trigger": {
        "type": "treasureSearch",
        "area": "R07",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "The Snowshoes of Speed rest on top of the tomb. Read the artifact card in the Frozen Horror pack."
        },
        {
          "type": "giveItem",
          "text": "The Snowshoes of Speed (artifact, see its card)"
        }
      ]
    },
    {
      "id": "n-B",
      "letter": "B",
      "at": [3, 14],
      "trigger": {
        "type": "areaRevealed",
        "area": "R20"
      },
      "effects": [
        {
          "type": "showText",
          "text": "A locked cage stands in the middle of this room, and an Ice Gremlin sits inside. It begs the heroes to let it out, swearing that the Frozen Horror left it here to die and that it wants revenge. The cage cannot be entered and it blocks line of sight, until it is opened. You apply this at the table."
        }
      ]
    },
    {
      "id": "n-B-free",
      "target": {
        "kind": "monster",
        "id": "m-gremlin"
      },
      "when": [
        {
          "flag": "gremlinFreed",
          "is": false
        }
      ],
      "trigger": {
        "type": "manual",
        "label": "Free the gremlin",
        "repeat": true
      },
      "effects": [
        {
          "type": "promptChoice",
          "text": "The gremlin waits behind the bars. Does a hero say they are freeing it and step next to the cage?",
          "options": [
            {
              "label": "Yes, a hero frees it",
              "effects": [
                {
                  "type": "showText",
                  "text": "The cage swings open and the Ice Gremlin leaps out. It steals one item from the hero who freed it, and it chooses which one: never the armor or shield the hero is using, and never the weapon in their hand. Cross the item off that hero's sheet. Then the gremlin drops through a hole in the floor: take its figure off the board.",
                  "title": "The cage opens"
                },
                {
                  "type": "setFlag",
                  "flag": "gremlinFreed",
                  "value": true
                },
                {
                  "type": "setMonsterState",
                  "monster": "m-gremlin",
                  "state": "away"
                }
              ]
            },
            {
              "label": "No, leave it",
              "effects": []
            }
          ]
        }
      ]
    },
    {
      "id": "n-C",
      "letter": "C",
      "at": [8, 17],
      "trigger": {
        "type": "treasureSearch",
        "area": "R17",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "A spell scroll is hidden inside the bookcase. The hero draws one spell scroll card at random and writes it on their character sheet."
        },
        {
          "type": "giveItem",
          "text": "A spell scroll (drawn at random from the spell scroll cards)"
        }
      ]
    },
    {
      "id": "n-D",
      "letter": "D",
      "at": [8, 12],
      "trigger": {
        "type": "treasureSearch",
        "area": "R14",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "The chest is rigged with an explosive device. If a hero searches it before the trap is disarmed, every hero in the room loses 2 Body Points. The chest holds 600 gold coins, shared among the surviving heroes."
        },
        {
          "type": "giveItem",
          "text": "600 gold coins"
        }
      ]
    },
    {
      "id": "n-E",
      "letter": "E",
      "at": [14, 1],
      "trigger": {
        "type": "areaRevealed",
        "area": "R04"
      },
      "effects": [
        {
          "type": "showText",
          "text": "A narrow ice ledge runs around a deep crevasse, and it is very slippery. When a hero steps through a door onto their first square here, they roll 1 combat die. Skull or white shield: they keep their footing and may go on. Black shield: they start to slip and lose 1 Body Point, then roll again at once. A second black shield: they fall into the crevasse and are lost for good. Any other result: they go back to the square they came in on, and their turn ends. The same roll is made at the start of every turn a hero begins in this room.",
          "title": "The ice ledge"
        }
      ]
    }
  ],
