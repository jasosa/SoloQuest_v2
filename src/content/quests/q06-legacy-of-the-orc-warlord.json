  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "type": "showText",
          "title": "Prisoners without gear",
          "text": "The heroes begin inside the cell. Their gear was confiscated: no gear of any kind, and no spells, until they get it back from the room with the cupboard (A). Until then each hero fights with 1 attack die and defends with 2 dice. Searching the cell for treasure is not allowed."
        }
      ]
    },
    {
      "id": "n-cell",
      "trigger": {
        "type": "treasureSearch",
        "area": "R13"
      },
      "effects": [
        {
          "type": "showText",
          "text": "There is nothing to search for in the cell. The hero keeps the action."
        }
      ],
      "blocksSearch": true
    },
    {
      "id": "n-A",
      "letter": "A",
      "at": [1, 3],
      "trigger": {
        "type": "treasureSearch",
        "area": "R01",
        "first": true
      },
      "effects": [
        {
          "type": "showText",
          "title": "Equipment found",
          "text": "The heroes' confiscated gear lies in the cupboard of this room. Once it is searched, the gear is found. Every other hero has to come into this room to get their things. Entering the room gives a hero the equipment back, and a spellcaster gets spells back too."
        },
        {
          "type": "giveItem",
          "text": "All heroes get their own equipment back when they enter this room"
        }
      ],
      "consumesTreasure": true
    },
    {
      "id": "n-grak-dead",
      "trigger": {
        "type": "monsterKilled",
        "monster": "m-grak"
      },
      "effects": [
        {
          "type": "showText",
          "text": "Grak falls. His Wizard's Cloak is a prize for the wizard: give the wizard the Wizard's Cloak artifact card."
        },
        {
          "type": "giveItem",
          "text": "Wizard's Cloak artifact card, for the wizard"
        }
      ]
    }
  ],
