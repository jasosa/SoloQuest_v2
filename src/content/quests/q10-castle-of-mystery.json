  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "type": "showText",
          "title": "Magic doors",
          "text": "Every door in this castle works as a teleporter. The moment a hero passes through any door, the hero halts and throws 2 red dice. The total names a numbered square, and the hero is moved there. If a figure already stands on that square, the arriving hero lands on it: that hero or monster loses 1 Body Point and, if still alive, throws 2 red dice and is teleported in turn (a total naming the same square is thrown again). The hero who arrived first keeps the square. Each hero may use a single door in a turn. The square marked 2/12 is inside the start room, just in from door d10. From it a hero can walk to the stairs and leave the quest. The players apply all of this by hand."
        }
      ]
    },
    {
      "id": "n-A",
      "letter": "A",
      "at": [23, 11],
      "trigger": {
        "type": "treasureSearch",
        "area": "R16"
      },
      "when": [
        {
          "monster": "m-dw-a1",
          "alive": false
        },
        {
          "monster": "m-dw-a2",
          "alive": false
        },
        {
          "firstTime": true
        }
      ],
      "effects": [
        {
          "type": "showText",
          "text": "Both Dread warriors lie dead. The first hero to search this room discovers that one of them was carrying the magic Ring of Return. Hand over its artifact card, which describes how it works."
        },
        {
          "type": "giveItem",
          "text": "Ring of Return artifact card, to the first hero who searches"
        }
      ],
      "consumesTreasure": true
    },
    {
      "id": "n-B",
      "letter": "B",
      "at": [14, 4],
      "trigger": {
        "type": "squareEntered",
        "cell": [14, 4]
      },
      "effects": [
        {
          "type": "showText",
          "title": "Mine entrance",
          "text": "This square is the way into the gold mine. One hero here may take 5,000 gold coins. A hero loaded with this gold cannot attack or defend. If the hero sets it down, the gold is gone again."
        }
      ]
    },
