  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "The heroes come in through the iron door on the west edge of the map. First they must find the spiral stairway that leads down to the catacombs. The Crystal Key is down there, and it opens the door of the Seat of Power Room, where the Frozen Horror waits. The quest is over when the Frozen Horror is destroyed. Mind and Body Points are not restored when the heroes go down or come back up.",
          "title": "The Heart of Ice"
        }
      ]
    },
    {
      "id": "n-A",
      "map": "halls",
      "letter": "A",
      "at": [7, 6],
      "trigger": {
        "type": "areaRevealed",
        "area": "R08"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "A spiral stairway winds down in the corner of this room. A hero who steps onto it leaves the board: take that figure off. The heroes can only go down together, so nobody goes until every hero is on the stairway."
        }
      ]
    },
    {
      "id": "n-A-down",
      "map": "halls",
      "target": {
        "kind": "furniture",
        "id": "f-h-stairs"
      },
      "trigger": {
        "type": "manual",
        "label": "Go down the stairway",
        "hint": "Every hero has to be on the stairway first.",
        "repeat": true
      },
      "effects": [
        {
          "id": "e1",
          "type": "promptChoice",
          "text": "Are all heroes on the stairway?",
          "options": [
            {
              "id": "o1",
              "label": "Yes, all of them",
              "effects": [
                {
                  "id": "e1",
                  "type": "showText",
                  "text": "Take every piece of this map off the board. Put out only the room that holds the stairway below, and add the rest as the heroes explore it. Monsters that were killed up here do not come back.",
                  "title": "Clear the board"
                },
                {
                  "id": "e2",
                  "type": "crossMap",
                  "link": "l1"
                }
              ]
            },
            {
              "id": "o2",
              "label": "No, not yet",
              "effects": []
            }
          ]
        }
      ]
    },
    {
      "id": "n-B",
      "map": "halls",
      "letter": "B",
      "at": [4, 11],
      "trigger": {
        "type": "areaRevealed",
        "area": "R12"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "Fog swirls through this room and nothing in it is quite what it seems. Whenever a hero attacks a monster here, the hero rolls 1 combat die first. A skull or a black shield: the hero swings at a fog likeness and the attack is wasted. A white shield: the hero sees the real monster, rolls the normal attack dice, and the monster defends as usual. The monsters are never fooled and always see the heroes correctly.",
          "title": "Living fog"
        }
      ]
    },
    {
      "id": "n-C1",
      "map": "halls",
      "letter": "C",
      "at": [10, 13],
      "trigger": {
        "type": "areaRevealed",
        "area": "R18"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "This ice tunnel is linked to the ice tunnel in the other room marked C. A hero or monster that lands on either square is moved at once to the other one."
        }
      ]
    },
    {
      "id": "n-C2",
      "map": "halls",
      "letter": "C",
      "at": [15, 13],
      "trigger": {
        "type": "areaRevealed",
        "area": "R19"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "This ice tunnel is linked to the ice tunnel in the other room marked C. A hero or monster that lands on either square is moved at once to the other one."
        }
      ]
    },
    {
      "id": "n-D",
      "map": "halls",
      "letter": "D",
      "at": [20, 16],
      "trigger": {
        "type": "treasureSearch",
        "area": "R21",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "The first hero to search this ice vault finds 400 gold coins and 2 potions of healing in the chest. Each potion restores up to 4 lost Body Points."
        },
        {
          "id": "e2",
          "type": "giveItem",
          "text": "400 gold coins and 2 potions of healing (up to 4 Body Points each)"
        }
      ]
    },
    {
      "id": "n-E",
      "map": "halls",
      "letter": "E",
      "at": [15, 3],
      "trigger": {
        "type": "treasureSearch",
        "area": "R04",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "On the alchemist's table the first hero to search finds a spell scroll and a potion of healing. The potion restores up to 4 lost Body Points. For the scroll, the hero draws one spell scroll card at random and writes it on their character sheet."
        },
        {
          "id": "e2",
          "type": "giveItem",
          "text": "One random spell scroll and a potion of healing (up to 4 Body Points)"
        }
      ]
    },
    {
      "id": "n-F",
      "map": "halls",
      "letter": "F",
      "at": [12, 9],
      "trigger": {
        "type": "areaRevealed",
        "area": "R11"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "The Frozen Horror holds court in this room, guarded by warbears, yetis and dread warriors. It fills a block of 2 x 2 squares and can squeeze through a corridor only 1 square wide. Its monster card lists its stats and its Dread spells.",
          "title": "The Seat of Power"
        }
      ]
    },
