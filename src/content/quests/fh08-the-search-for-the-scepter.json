  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "type": "showText",
          "text": "Ice tunnels come in pairs with the same letter: A, D and E. A hero or monster that lands on one comes out at the other, and that ends its move.",
          "title": "Ice tunnels"
        }
      ]
    },
    {
      "id": "n-B",
      "letter": "B",
      "at": [24, 14],
      "trigger": {
        "type": "treasureSearch",
        "area": "R22",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "A spell scroll is hidden in the bookcase. The first hero to search here takes it: shuffle the spell scroll cards of the pack face down, let the hero draw one at random and write it on their character sheet."
        },
        {
          "type": "giveItem",
          "text": "One random spell scroll (draw from the pack)"
        }
      ]
    },
    {
      "id": "n-C",
      "letter": "C",
      "at": [6, 12],
      "trigger": {
        "type": "treasureSearch",
        "area": "R13",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "The chest carries a poison needle trap. A hero who searches it before the trap is disarmed loses 2 Body Points (see the trap). Inside are 200 gold coins and 2 potions of healing, each restoring up to 4 lost Body Points."
        },
        {
          "type": "giveItem",
          "text": "200 gold coins and 2 potions of healing (4 Body Points each)"
        }
      ]
    },
    {
      "id": "n-F",
      "letter": "F",
      "at": [14, 1],
      "trigger": {
        "type": "areaRevealed",
        "area": "R04"
      },
      "effects": [
        {
          "type": "showText",
          "text": "A deep crevasse splits this room, with a slippery ledge around it. Heroes move along the ledge by the ice ledge rule, the same one as room E of Quest 4. It is written on the ice ledge tile."
        }
      ]
    },
    {
      "id": "n-G",
      "letter": "G",
      "at": [21, 1],
      "trigger": {
        "type": "areaRevealed",
        "area": "R06"
      },
      "effects": [
        {
          "type": "showText",
          "text": "The Scepter of Glacial Majesty is frozen into the wall in the upper right corner square of this room. Heroes can neither move it nor use it. To destroy it, a hero must stand next to it, attack it and roll at least one skull on the combat dice."
        }
      ]
    },
    {
      "id": "n-G-scepter",
      "target": {
        "kind": "square",
        "id": "24,1"
      },
      "when": [
        {
          "flag": "scepterDestroyed",
          "is": false
        }
      ],
      "trigger": {
