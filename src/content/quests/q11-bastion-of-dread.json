      "effects": [
        {
          "type": "showText",
          "text": "The first hero to search the armory takes a shield identical to the one on the armory card. Every other weapon lying here is broken and useless."
        },
        {
          "type": "giveItem",
          "text": "A shield, same as the armory shield"
        }
      ],
      "consumesTreasure": true
    },
    {
      "id": "n-B",
