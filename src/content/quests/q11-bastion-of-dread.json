      "trigger": {
        "type": "areaRevealed",
        "area": "R13"
      },
      "effects": [
        {
          "type": "showText",
          "text": "A gargoyle stands in this room, a motionless statue, and a treasure chest sits near it."
        }
      ]
    },
    {
      "id": "n-B-wake",
      "trigger": {
        "type": "trapSprung",
        "trap": "t-chest"
      },
      "effects": [
        {
          "type": "showText",
          "title": "The gargoyle wakes",
          "text": "The gargoyle lurches awake and goes for the searching hero on the spot. Reminder for the players: hits on it count for nothing until it has either moved or attacked."
        },
        {
          "type": "setMonsterState",
          "monster": "m-gargoyle",
          "state": "active"
        }
      ]
    },
    {
      "id": "n-B-disarm",
      "trigger": {
        "type": "trapDisarmed",
        "trap": "t-chest"
      },
      "effects": [
        {
          "type": "showText",
          "title": "Trap disarmed",
          "text": "You disarmed the trap. Had it stayed armed, searching the chest would have woken the gargoyle, and it would have struck at once. The statue stays still."
        }
      ]
    },
    {
      "id": "n-C",
      "letter": "C",
      "at": [15, 10],
      "trigger": {
        "type": "monsterKilled",
        "monster": "m-c"
      },
      "effects": [
        {
          "type": "showText",
          "text": "The Dread warrior here wields Orc's Bane, an artifact sword. Whoever slays him can claim it. Its rules are on the artifact card."
        },
        {
          "type": "giveItem",
          "text": "Orc's Bane (artifact sword, see its card)"
        }
      ]
    }
