  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "type": "showText",
          "text": "The hero has a wolf ally for this solo quest. Use the eye token or a spare figure for Snowdasher. She moves 10, attacks with 3 dice (she may attack diagonally), defends with 2 and has 5 Body Points and 1 Mind Point. She moves and attacks right after the hero, and she cannot carry items or open doors.",
          "title": "Snowdasher"
        },
        {
          "type": "showText",
          "text": "Ice tunnels come in pairs with the same picture (1, 2 or 3). A hero or monster that lands on one moves at once to the other square of the pair, and that ends its move. If that square is taken, move the figure there to a free square next to it.",
          "title": "Ice tunnels"
        }
      ]
    },
    {
      "id": "n-A",
      "letter": "A",
      "at": [
        7,
        11
      ],
      "trigger": {
        "type": "areaRevealed",
        "area": "R14"
      },
      "effects": [
        {
          "type": "showText",
          "text": "An Ice Gremlin is picking through the scraps of a long dead explorer."
        }
      ]
    },
    {
      "id": "n-A-search",
      "trigger": {
        "type": "treasureSearch",
        "area": "R14",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "Among the remains lies a backpack. Inside are a usable tool kit (see the armory) and 2 potions of healing, each restoring up to 4 lost Body Points."
        },
        {
          "type": "giveItem",
          "text": "A tool kit and 2 potions of healing (4 Body Points each)"
        }
      ]
    },
    {
      "id": "n-B",
      "letter": "B",
      "at": [
        13,
        14
      ],
      "trigger": {
        "type": "monsterSeen",
        "monster": "m-mummy"
      },
      "effects": [
        {
          "type": "showText",
          "text": "A large white wolf lifts its head and opens its jaws, but no sound comes out. Its body is more bone than fur, and its hollow eyes glow dull purple. It is a wolf mummy. If Snowdasher is with the hero, she howls with mourning and rage."
        }
      ]
    },
    {
      "id": "n-C",
      "letter": "C",
      "at": [
        8,
        1
      ],
      "trigger": {
        "type": "areaRevealed",
        "area": "R02"
      },
      "effects": [
        {
          "type": "showText",
          "text": "An old Polar Warbear is trapped in a cage. The cage cannot be entered and blocks line of sight until a lever on the wall is pulled. The lever is at the square marked C, and pulling it takes no action."
        }
      ]
    },
    {
      "id": "n-C-lever",
      "target": {
        "kind": "square",
        "id": "8,1"
      },
      "trigger": {
        "type": "manual",
        "label": "The lever was pulled"
      },
      "effects": [
        {
          "type": "showText",
          "text": "The cage opens, and the line of sight is clear. The Warbear will leave if the hero lets it pass unharmed: tap It left on the monster. If the hero attacks it, tap A hero attacked it."
        },
        {
          "type": "setFlag",
          "flag": "cageOpen",
          "value": true
        }
      ]
    },
    {
      "id": "n-C-search",
      "trigger": {
