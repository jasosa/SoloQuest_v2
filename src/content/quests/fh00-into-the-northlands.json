        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "In the tomb the hero finds a set of bracers with a wolf embossing (see the armory) and a potion of healing that restores up to 4 lost Body Points."
        },
        {
          "type": "giveItem",
          "text": "Bracers with a wolf embossing and a potion of healing (4 Body Points)"
        }
      ]
    },
    {
      "id": "n-E",
      "letter": "E",
      "at": [
        19,
        15
      ],
      "trigger": {
        "type": "areaRevealed",
        "area": "R21"
      },
      "effects": [
        {
          "type": "showText",
          "text": "This room is littered with junk! Ice Gremlins steal anything they can, and their loot is all kept here. A hero who enters gets back any item an Ice Gremlin stole from them earlier in this quest."
        }
      ]
    },
    {
      "id": "n-E-search",
      "trigger": {
        "type": "treasureSearch",
        "area": "R21",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "The hero finds a well kept, polished shell helmet (see the armory), a potion of healing (up to 4 Body Points) and 50 gold coins."
        },
        {
          "type": "giveItem",
          "text": "A polished shell helmet, a potion of healing (4 Body Points) and 50 gold coins"
        }
