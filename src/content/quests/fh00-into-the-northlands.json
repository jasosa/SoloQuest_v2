  "notes": [
    {
      "id": "n-start",
      "trigger": {
        "type": "questStart"
      },
      "effects": [
        {
          "type": "showText",
          "text": "Snowdasher, the wolf, joins the hero as an animal ally. Her stats are in the NPC list.",
          "title": "Snowdasher"
        },
        {
          "type": "spawnNpc",
          "npc": "snowdasher"
        },
        {
          "type": "showText",
          "text": "Ice tunnels come in pairs with the same number. A hero or monster that lands on one comes out at the other, and that ends its move.",
          "title": "Ice tunnels"
        }
      ]
    },
    {
      "id": "n-A",
      "letter": "A",
