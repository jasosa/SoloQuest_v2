        "area": "R02",
        "first": true
      },
      "consumesTreasure": true,
      "effects": [
        {
          "type": "showText",
          "text": "A longsword lies here (see the armory)."
        },
        {
          "type": "giveItem",
          "text": "A longsword"
        }
      ]
    },
    {
      "id": "n-D",
