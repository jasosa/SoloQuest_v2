    {
      "id": "n-D",
      "letter": "D",
      "at": [22, 12],
      "trigger": {
        "type": "areaRevealed",
        "area": "R16"
      },
      "effects": [
        {
          "id": "e1",
          "type": "showText",
          "text": "Nothing in the living fog room is quite what it seems. Monsters and fog likenesses of monsters fill the room. Every time a hero attacks a monster here, the hero rolls 1 combat die first. A black shield or a skull: the hero is confused and strikes a fog likeness, so the attack is wasted. A white shield: the hero sees the real monster, rolls the normal attack dice and the monster defends as usual. The monsters are never fooled and always see the heroes correctly.",
          "title": "Living fog"
        }
      ]
    }
